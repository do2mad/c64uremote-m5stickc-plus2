#pragma once
// Diese Datei nach build_env.h kopieren und ausfuellen.
//
// Seit der WLAN-Einrichtung im Geraet sind das nur noch STARTWERTE. Sie
// greifen genau so lange, bis zum ersten Mal etwas im Geraet gespeichert
// wurde - ueber eine WLAN-NFC-Karte oder das Setup-Portal. Danach gilt der
// interne Speicher (NVS).
//
// Die Felder duerfen deshalb auch leer bleiben; der Stick verweist beim
// ersten Start dann auf MENUE > WLAN.
#define C64U_WIFI_SSID     "MeinWLAN"
#define C64U_WIFI_PASSWORD "MeinWlanPasswort"
#define C64U_TARGET_HOST   "192.168.0.64"
#define C64U_TARGET_PASSWORD ""
